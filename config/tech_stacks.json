{
  "react-fastapi": {
    "name": "React + FastAPI",
    "description": "通用应用、仪表盘、管理面板",
    "backend": {
      "framework": "fastapi",
      "language": "python",
      "dependencies": {
        "fastapi": "0.109.0",
        "uvicorn[standard]": "0.27.0",
        "sqlalchemy": "2.0.25",
        "pydantic": "2.6.0",
        "python-multipart": "0.0.9"
      }
    },
    "frontend": {
      "framework": "react",
      "build_tool": "vite",
      "ui_library": "tailwind",
      "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.21.0"
      },
      "devDependencies": {
        "@types/react": "^18.2.47",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.1",
        "vite": "^5.0.11"
      }
    },
    "database": "sqlite",
    "default_ports": {
      "backend": 8000,
      "frontend": 5173
    }
  }
}
