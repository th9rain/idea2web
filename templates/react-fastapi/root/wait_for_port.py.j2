"""
端口就绪检测工具
等待指定端口上的服务启动完成
"""

import socket
import time
import sys


def wait_for_port(port, host='127.0.0.1', timeout=60, interval=0.5):
    """
    等待端口就绪

    Args:
        port: 端口号
        host: 主机地址
        timeout: 超时时间（秒）
        interval: 检查间隔（秒）

    Returns:
        True: 端口就绪
        False: 超时
    """
    start_time = time.time()

    while time.time() - start_time < timeout:
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                s.settimeout(1)
                result = s.connect_ex((host, port))
                if result == 0:
                    # 端口可以连接，说明服务已启动
                    return True
        except Exception:
            pass

        time.sleep(interval)

    return False


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("用法: python wait_for_port.py <端口号> [超时时间]")
        sys.exit(1)

    port = int(sys.argv[1])
    timeout = int(sys.argv[2]) if len(sys.argv) > 2 else 60

    print(f"⏳ 等待端口 {port} 就绪（超时 {timeout} 秒）...")

    if wait_for_port(port, timeout=timeout):
        print(f"✅ 端口 {port} 已就绪")
        sys.exit(0)
    else:
        print(f"❌ 端口 {port} 启动超时（{timeout} 秒）")
        sys.exit(1)
