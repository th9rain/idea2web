@echo off
chcp 65001 >nul 2>&1
title {{ app_name }} - 启动中
color 0A

echo ============================================================
echo              {{ app_name }} - 一键启动
echo ============================================================
echo.

REM 运行健康检查
echo [0/6] 运行健康检查和自动修复...
python check_and_fix.py
if %errorlevel% neq 0 (
    echo.
    echo [错误] 健康检查失败！
    echo 请查看 diagnostic_report.txt 获取详细信息。
    echo.
    pause
    exit /b 1
)
echo     ✓ 健康检查通过
echo.

REM 检查是否已有服务在运行
netstat -ano | findstr ":{{ backend_port }}" >nul 2>&1
if %errorlevel%==0 (
    echo [警告] 端口 {{ backend_port }} 已被占用！
    echo 请先运行 stop.bat 停止旧服务，或者手动释放端口。
    echo.
    pause
    exit /b 1
)

netstat -ano | findstr ":{{ frontend_port }}" >nul 2>&1
if %errorlevel%==0 (
    echo [警告] 端口 {{ frontend_port }} 已被占用！
    echo 请先运行 stop.bat 停止旧服务，或者手动释放端口。
    echo.
    pause
    exit /b 1
)

echo [1/6] 检查 Python 环境...
python --version >nul 2>&1
if %errorlevel% neq 0 (
    echo [错误] 未找到 Python！
    echo.
    echo 请先安装 Python 3.8+：
    echo   https://www.python.org/downloads/
    echo.
    pause
    exit /b 1
)
echo     ✓ Python 已安装

echo [2/6] 检查虚拟环境...
if not exist "backend\venv\Scripts\python.exe" (
    echo [自动安装] 正在创建 Python 虚拟环境...
    cd backend
    python -m venv venv
    if %errorlevel% neq 0 (
        echo [错误] 虚拟环境创建失败！
        echo 请检查 Python 安装是否正确。
        cd ..
        pause
        exit /b 1
    )
    echo     ✓ 虚拟环境创建成功

    echo [自动安装] 正在安装 Python 依赖（使用清华镜像源）...
    venv\Scripts\python.exe -m pip install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple >nul 2>&1
    venv\Scripts\python.exe -m pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple
    if %errorlevel% neq 0 (
        echo [错误] Python 依赖安装失败！
        echo.
        echo 可能的原因：
        echo   1. 网络连接问题
        echo   2. requirements.txt 中的包不存在
        echo.
        echo 请查看上面的错误信息，或手动安装：
        echo   cd backend
        echo   venv\Scripts\python.exe -m pip install -r requirements.txt
        echo.
        cd ..
        pause
        exit /b 1
    )
    echo     ✓ Python 依赖安装成功
    cd ..
) else (
    echo     ✓ Python 虚拟环境已存在
)

echo [3/6] 检查 Node.js 环境...
npm --version >nul 2>&1
if %errorlevel% neq 0 (
    echo [错误] 未找到 Node.js！
    echo.
    echo 请先安装 Node.js 18+：
    echo   https://nodejs.org/
    echo.
    pause
    exit /b 1
)
echo     ✓ Node.js 已安装

echo [4/6] 检查前端依赖...
if not exist "frontend\node_modules" (
    echo [自动安装] 正在安装前端依赖（使用淘宝镜像源）...
    cd frontend
    npm install --registry=https://registry.npmmirror.com
    if %errorlevel% neq 0 (
        echo [错误] 前端依赖安装失败！
        echo.
        echo 可能的原因：
        echo   1. 网络连接问题
        echo   2. package.json 中的包不存在
        echo.
        echo 请查看上面的错误信息，或手动安装：
        echo   cd frontend
        echo   npm install
        echo.
        cd ..
        pause
        exit /b 1
    )
    echo     ✓ 前端依赖安装成功
    cd ..
) else (
    echo     ✓ 前端依赖已存在
)

echo [5/6] 初始化数据库...
if not exist "backend\app.db" (
    cd backend
    venv\Scripts\python.exe seed.py
    cd ..
    echo     ✓ 数据库已初始化（包含测试数据）
) else (
    echo     ✓ 数据库已存在，跳过初始化
)

echo [6/6] 启动服务...
echo.

REM 启动后端
start "{{ app_name }}-后端服务" cmd /k "cd /d "%~dp0backend" && venv\Scripts\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port {{ backend_port }}"
echo     ✓ 后端服务窗口已打开

REM 等待后端启动（使用 wait_for_port.py）
python wait_for_port.py {{ backend_port }} 30
if %errorlevel% neq 0 (
    echo.
    echo [错误] 后端启动失败或超时！
    echo 请检查后端服务窗口的错误信息。
    echo.
    pause
    exit /b 1
)
echo     ✓ 后端服务已就绪

REM 启动前端
start "{{ app_name }}-前端服务" cmd /k "cd /d "%~dp0frontend" && npm run dev"
echo     ✓ 前端服务窗口已打开

REM 等待前端启动
python wait_for_port.py {{ frontend_port }} 30
if %errorlevel% neq 0 (
    echo.
    echo [警告] 前端启动可能失败或超时。
    echo 请检查前端服务窗口的错误信息。
)
echo     ✓ 前端服务已就绪

echo.
echo ============================================================
echo                   启动完成！
echo ============================================================
echo.
echo  前端地址: http://localhost:{{ frontend_port }}
echo  后端地址: http://localhost:{{ backend_port }}
echo  API 文档: http://localhost:{{ backend_port }}/docs
echo.
{% if has_auth -%}
echo  测试账号:
echo    用户名: testuser
echo    密码:   password123
echo.
{% endif -%}
echo  提示:
echo    - 两个服务窗口将保持打开，不要关闭
echo    - 停止服务请运行: stop.bat
echo    - 或直接关闭两个服务窗口
echo.
echo ============================================================

REM 短暂等待以确保前端页面完全加载
timeout /t 2 /nobreak >nul 2>&1

REM 自动打开浏览器
start http://localhost:{{ frontend_port }}

echo.
echo 浏览器已打开，祝您使用愉快！
echo.
pause
