"""
{{ app_name }} 健康检查和自动修复脚本

在启动前进行全面检查，自动修复常见问题
"""

import sys
import os
import json
import subprocess
import shutil
from pathlib import Path
from typing import List, Tuple, Dict


class HealthChecker:
    """健康检查器"""

    def __init__(self):
        self.project_dir = Path(__file__).parent
        self.issues = []  # 发现的问题列表
        self.fixes = []   # 修复记录列表
        self.errors = []  # 无法修复的错误列表

    def log(self, message: str, level: str = "INFO"):
        """输出日志"""
        colors = {
            "INFO": "\033[36m",    # 青色
            "SUCCESS": "\033[32m", # 绿色
            "WARNING": "\033[33m", # 黄色
            "ERROR": "\033[31m",   # 红色
            "RESET": "\033[0m"
        }
        color = colors.get(level, colors["INFO"])
        print(f"{color}[{level}]{colors['RESET']} {message}")

    def check_python_version(self) -> bool:
        """检查 Python 版本"""
        self.log("检查 Python 版本...", "INFO")

        version = sys.version_info
        if version.major < 3 or (version.major == 3 and version.minor < 8):
            self.errors.append({
                "type": "environment",
                "message": f"Python 版本过低：{sys.version}",
                "solution": "请安装 Python 3.8 或更高版本\n下载地址：https://www.python.org/downloads/"
            })
            return False

        self.log(f"✓ Python 版本：{sys.version.split()[0]}", "SUCCESS")
        return True

    def check_node_version(self) -> bool:
        """检查 Node.js 版本"""
        self.log("检查 Node.js 版本...", "INFO")

        try:
            result = subprocess.run(
                ["node", "--version"],
                capture_output=True,
                text=True,
                timeout=5
            )

            if result.returncode == 0:
                version_str = result.stdout.strip()
                self.log(f"✓ Node.js 版本：{version_str}", "SUCCESS")

                # 检查版本是否 >= 18
                version_num = int(version_str.replace('v', '').split('.')[0])
                if version_num < 18:
                    self.issues.append({
                        "type": "version",
                        "message": f"Node.js 版本过低：{version_str}，建议 >= 18"
                    })
                    self.log(f"⚠ Node.js 版本建议升级到 18+", "WARNING")

                return True
        except (FileNotFoundError, subprocess.TimeoutExpired):
            self.errors.append({
                "type": "environment",
                "message": "未找到 Node.js",
                "solution": "请安装 Node.js 18 或更高版本\n下载地址：https://nodejs.org/"
            })
            return False

    def check_dependency_files(self) -> bool:
        """检查依赖文件完整性"""
        self.log("检查依赖文件...", "INFO")

        required_files = [
            ("backend/requirements.txt", "后端依赖文件"),
            ("frontend/package.json", "前端依赖文件"),
        ]

        all_ok = True
        for file_path, desc in required_files:
            full_path = self.project_dir / file_path
            if not full_path.exists():
                self.errors.append({
                    "type": "missing_file",
                    "message": f"缺失关键文件：{file_path}",
                    "solution": f"请重新生成项目或手动创建 {file_path}"
                })
                all_ok = False
            else:
                # 验证文件不为空
                if full_path.stat().st_size == 0:
                    self.errors.append({
                        "type": "empty_file",
                        "message": f"文件为空：{file_path}",
                        "solution": f"请检查 {file_path} 的内容"
                    })
                    all_ok = False
                else:
                    self.log(f"✓ {desc} 存在", "SUCCESS")

        return all_ok

    def check_config_files(self) -> bool:
        """检查配置文件格式"""
        self.log("检查配置文件格式...", "INFO")

        json_files = [
            ("frontend/package.json", "前端依赖配置"),
            ("frontend/tailwind.config.js", "Tailwind 配置", "js"),
        ]

        all_ok = True
        for file_path, desc, *file_type in json_files:
            full_path = self.project_dir / file_path
            if not full_path.exists():
                continue

            # JSON 文件验证
            if len(file_type) == 0 and file_path.endswith('.json'):
                try:
                    with open(full_path, 'r', encoding='utf-8') as f:
                        json.load(f)
                    self.log(f"✓ {desc} 格式正确", "SUCCESS")
                except json.JSONDecodeError as e:
                    self.errors.append({
                        "type": "invalid_config",
                        "message": f"{desc} 格式错误：{e}",
                        "solution": f"请检查 {file_path} 的 JSON 格式"
                    })
                    all_ok = False
            else:
                self.log(f"✓ {desc} 存在", "SUCCESS")

        return all_ok

    def check_ports(self) -> bool:
        """检查端口可用性"""
        self.log("检查端口可用性...", "INFO")

        ports = [{{ backend_port }}, {{ frontend_port }}]

        import socket
        all_ok = True
        for port in ports:
            try:
                with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                    s.settimeout(1)
                    result = s.connect_ex(('127.0.0.1', port))
                    if result == 0:
                        # 端口被占用
                        self.issues.append({
                            "type": "port_occupied",
                            "port": port,
                            "message": f"端口 {port} 已被占用"
                        })
                        self.log(f"⚠ 端口 {port} 已被占用", "WARNING")
                        all_ok = False
                    else:
                        self.log(f"✓ 端口 {port} 可用", "SUCCESS")
            except Exception as e:
                self.log(f"⚠ 无法检查端口 {port}：{e}", "WARNING")

        return all_ok

    def check_disk_space(self) -> bool:
        """检查磁盘空间"""
        self.log("检查磁盘空间...", "INFO")

        try:
            stat = shutil.disk_usage(str(self.project_dir))
            free_gb = stat.free / (1024 ** 3)

            if free_gb < 1:  # 少于 1GB
                self.issues.append({
                    "type": "low_disk_space",
                    "message": f"磁盘空间不足：剩余 {free_gb:.2f}GB"
                })
                self.log(f"⚠ 磁盘空间不足：{free_gb:.2f}GB", "WARNING")
                return False
            else:
                self.log(f"✓ 磁盘空间充足：{free_gb:.2f}GB", "SUCCESS")
                return True
        except Exception as e:
            self.log(f"⚠ 无法检查磁盘空间：{e}", "WARNING")
            return True

    def fix_backend_venv(self) -> bool:
        """修复后端虚拟环境"""
        backend_dir = self.project_dir / "backend"
        venv_dir = backend_dir / "venv"

        # 检查虚拟环境是否存在
        venv_python = venv_dir / "Scripts" / "python.exe"
        if not venv_python.exists():
            venv_python = venv_dir / "bin" / "python"

        if not venv_python.exists():
            self.log("自动修复：创建后端虚拟环境...", "INFO")
            try:
                result = subprocess.run(
                    [sys.executable, "-m", "venv", str(venv_dir)],
                    capture_output=True,
                    text=True,
                    timeout=60
                )

                if result.returncode == 0:
                    self.fixes.append("创建后端虚拟环境")
                    self.log("✓ 后端虚拟环境创建成功", "SUCCESS")
                    return True
                else:
                    self.errors.append({
                        "type": "venv_creation_failed",
                        "message": f"虚拟环境创建失败：{result.stderr}",
                        "solution": "请手动创建：cd backend && python -m venv venv"
                    })
                    return False
            except Exception as e:
                self.errors.append({
                    "type": "venv_creation_error",
                    "message": f"虚拟环境创建异常：{e}",
                    "solution": "请检查 Python 安装或手动创建虚拟环境"
                })
                return False

        return True

    def fix_missing_dependencies(self) -> bool:
        """修复缺失的依赖"""
        backend_dir = self.project_dir / "backend"
        frontend_dir = self.project_dir / "frontend"

        # 检查后端依赖
        requirements_file = backend_dir / "requirements.txt"
        if requirements_file.exists():
            venv_python = backend_dir / "venv" / "Scripts" / "python.exe"
            if not venv_python.exists():
                venv_python = backend_dir / "venv" / "bin" / "python"

            if venv_python.exists():
                # 检查是否已安装 fastapi
                result = subprocess.run(
                    [str(venv_python), "-c", "import fastapi"],
                    capture_output=True,
                    timeout=5
                )

                if result.returncode != 0:
                    self.log("自动修复：安装后端依赖...", "INFO")
                    try:
                        result = subprocess.run(
                            [str(venv_python), "-m", "pip", "install", "-r", str(requirements_file),
                             "-i", "https://pypi.tuna.tsinghua.edu.cn/simple"],
                            capture_output=True,
                            text=True,
                            timeout=300
                        )

                        if result.returncode == 0:
                            self.fixes.append("安装后端依赖")
                            self.log("✓ 后端依赖安装成功", "SUCCESS")
                        else:
                            self.log(f"⚠ 后端依赖安装失败：{result.stderr}", "WARNING")
                            return False
                    except Exception as e:
                        self.log(f"⚠ 后端依赖安装异常：{e}", "WARNING")
                        return False

        # 检查前端依赖
        node_modules = frontend_dir / "node_modules"
        if not node_modules.exists() or not any(node_modules.iterdir()):
            self.log("自动修复：安装前端依赖...", "INFO")
            try:
                result = subprocess.run(
                    ["npm", "install", "--registry=https://registry.npmmirror.com"],
                    cwd=str(frontend_dir),
                    capture_output=True,
                    text=True,
                    timeout=300
                )

                if result.returncode == 0:
                    self.fixes.append("安装前端依赖")
                    self.log("✓ 前端依赖安装成功", "SUCCESS")
                else:
                    self.log(f"⚠ 前端依赖安装失败：{result.stderr}", "WARNING")
                    return False
            except Exception as e:
                self.log(f"⚠ 前端依赖安装异常：{e}", "WARNING")
                return False

        return True

    def generate_diagnostic_report(self) -> str:
        """生成诊断报告"""
        report_path = self.project_dir / "diagnostic_report.txt"

        with open(report_path, 'w', encoding='utf-8') as f:
            f.write("=" * 60 + "\n")
            f.write("{{ app_name }} 诊断报告\n")
            f.write("=" * 60 + "\n\n")

            # 系统信息
            f.write("## 系统环境\n\n")
            f.write(f"Python 版本: {sys.version}\n")
            try:
                node_version = subprocess.run(["node", "--version"], capture_output=True, text=True, timeout=5)
                f.write(f"Node.js 版本: {node_version.stdout.strip() if node_version.returncode == 0 else '未安装'}\n")
            except:
                f.write("Node.js 版本: 未安装\n")

            try:
                npm_version = subprocess.run(["npm", "--version"], capture_output=True, text=True, timeout=5)
                f.write(f"npm 版本: {npm_version.stdout.strip() if npm_version.returncode == 0 else '未安装'}\n")
            except:
                f.write("npm 版本: 未安装\n")

            f.write(f"操作系统: {sys.platform}\n")
            f.write(f"项目路径: {self.project_dir}\n\n")

            # 发现的问题
            if self.issues:
                f.write("## 发现的问题（已尝试修复）\n\n")
                for i, issue in enumerate(self.issues, 1):
                    f.write(f"{i}. [{issue.get('type', 'unknown')}] {issue.get('message', '')}\n")
                f.write("\n")

            # 修复记录
            if self.fixes:
                f.write("## 自动修复记录\n\n")
                for i, fix in enumerate(self.fixes, 1):
                    f.write(f"{i}. {fix}\n")
                f.write("\n")

            # 无法修复的错误
            if self.errors:
                f.write("## 无法自动修复的错误\n\n")
                for i, error in enumerate(self.errors, 1):
                    f.write(f"{i}. [{error.get('type', 'unknown')}] {error.get('message', '')}\n")
                    f.write(f"   建议修复方法：\n")
                    f.write(f"   {error.get('solution', '请联系技术支持')}\n\n")

            # 复制给 AI 的格式
            f.write("=" * 60 + "\n")
            f.write("## 复制以下内容给 AI 分析\n")
            f.write("=" * 60 + "\n\n")
            f.write(f"项目：{{ app_name }}\n")
            f.write(f"Python: {sys.version}\n")
            if self.errors:
                f.write("\n遇到的错误：\n")
                for error in self.errors:
                    f.write(f"- {error.get('message', '')}\n")

        return str(report_path)

    def run(self) -> bool:
        """运行所有检查"""
        print("\n" + "=" * 60)
        print("{{ app_name }} - 健康检查")
        print("=" * 60 + "\n")

        checks = [
            ("Python 环境", self.check_python_version),
            ("Node.js 环境", self.check_node_version),
            ("依赖文件", self.check_dependency_files),
            ("配置文件", self.check_config_files),
            ("端口可用性", self.check_ports),
            ("磁盘空间", self.check_disk_space),
        ]

        all_passed = True
        for name, check_func in checks:
            if not check_func():
                all_passed = False

        # 尝试自动修复
        if not all_passed or self.issues:
            print("\n" + "-" * 60)
            self.log("尝试自动修复问题...", "INFO")
            print("-" * 60 + "\n")

            self.fix_backend_venv()
            self.fix_missing_dependencies()

        # 生成报告
        print("\n" + "=" * 60)
        if self.errors:
            self.log("健康检查失败！", "ERROR")
            report_path = self.generate_diagnostic_report()
            self.log(f"诊断报告已生成：{report_path}", "INFO")
            self.log("请查看报告并按照建议修复问题", "INFO")
            return False
        elif self.fixes:
            self.log("健康检查通过（已自动修复部分问题）", "SUCCESS")
            if self.issues:
                self.log(f"共发现 {len(self.issues)} 个问题，已自动修复 {len(self.fixes)} 个", "INFO")
            return True
        else:
            self.log("健康检查通过！", "SUCCESS")
            return True


if __name__ == "__main__":
    checker = HealthChecker()
    success = checker.run()
    sys.exit(0 if success else 1)
